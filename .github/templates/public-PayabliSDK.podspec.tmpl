#
# Payabli iOS SDK — public CocoaPods podspec.
# Generated from `.github/templates/public-PayabliSDK.podspec.tmpl` at release
# time. Do not edit by hand. Only `main`-branch releases are pushed to Trunk;
# `-qa` and `-beta` versions publish SPM-only.
#
# Ships three subspecs (TTP-only branch — PayIn is intentionally absent
# and lives unchanged on `develop`):
#   Core, TapToPay, PayabliCardReaderCore.
# TapToPay pulls in CardReaderCore transitively.
#
Pod::Spec.new do |s|
  s.name             = 'PayabliSDK'
  s.version          = '${VERSION}'
  s.summary          = 'Payabli iOS SDK for Tap to Pay on iPhone.'
  s.description      = <<-DESC
    PayabliSDK is the official iOS SDK for accepting payments via Payabli.
    This TTP-only build ships three modules: PayabliSDKCore (shared
    infrastructure), PayabliSDKTapToPay (Tap to Pay on iPhone, bilingual
    Swift/ObjC), and PayabliCardReaderCore (MIT-licensed Tap to Phone
    card reader engine). All modules are distributed as pre-built
    XCFrameworks.
  DESC

  s.homepage         = 'https://github.com/payabli/payabli-sdk-ios'
  s.license          = { :type => 'MIT', :file => 'LICENSE' }
  s.author           = { 'Payabli' => 'sdk-support@payabli.com' }
  s.source           = { :http => 'https://${S3_PUBLIC_HOST}/payabli-ios-sdk-${VERSION}.zip' }

  s.ios.deployment_target = '16.7'
  s.swift_version    = '5.9'

  s.default_subspecs = 'Core', 'TapToPay', 'PayabliCardReaderCore'

  s.subspec 'Core' do |ss|
    ss.vendored_frameworks = 'PayabliSDKCore.xcframework'
  end

  s.subspec 'TapToPay' do |ss|
    ss.dependency 'PayabliSDK/Core'
    ss.dependency 'PayabliSDK/PayabliCardReaderCore'
    ss.vendored_frameworks = 'PayabliSDKTapToPay.xcframework'
  end

  s.subspec 'PayabliCardReaderCore' do |ss|
    ss.vendored_frameworks = 'PayabliCardReaderCore.xcframework'
  end
end
