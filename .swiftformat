--swiftversion 5.9
--indent 4
--maxwidth 140
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--self init-only
--stripunusedargs closure-only
--commas inline
--trimwhitespace always
--semicolons never
--header ignore
--disable redundantSelf,redundantReturn
--exclude .build,.swiftpm,Example/PayabliDemo/build
