<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-ios17.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PayabliMauiDemo</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>PayabliMauiDemo</ApplicationTitle>
    <ApplicationId>com.payabli.mauidemo</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- TTP-only binding library that wraps the PayabliSDKTapToPay /
         PayabliSDKCore / PayabliCardReaderCore XCFrameworks.
         See Bridges/MAUI/README.md for the binding contract. -->
    <ProjectReference Include="..\..\Bridges\MAUI\Payabli.MAUI.csproj" />
  </ItemGroup>

</Project>
