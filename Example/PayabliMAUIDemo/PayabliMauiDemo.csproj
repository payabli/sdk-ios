<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.7</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>PayabliMauiDemo</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>PayabliMauiDemo</ApplicationTitle>
    <ApplicationId>com.payabli.mauidemo</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Binding library that wraps the PayabliSDKTapToPay /
         PayabliSDKPayInPaymentFlow / PayabliSDKCore / PayabliCardReaderCore XCFrameworks.
         See Bridges/README.md for the binding contract. -->
    <ProjectReference Include="..\..\Bridges\MAUI\Payabli.MAUI.csproj"
                      Condition="'$(TargetPlatformIdentifier)' == 'ios' Or $([System.String]::Copy('$(TargetFramework)').Contains('-ios'))" />
  </ItemGroup>

</Project>
