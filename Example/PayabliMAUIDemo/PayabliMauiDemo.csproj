<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-ios17.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PayabliMauiDemo</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>PayabliMauiDemo</ApplicationTitle>
    <ApplicationId>com.payabli.mauidemo</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Binding project that wraps the XCFramework.
         Generate with `dotnet new iosbinding` + sharpie; see Bridges/MAUI. -->
    <ProjectReference Include="..\..\Bridges\MAUI\PayabliBinding.csproj"
                      Condition="Exists('..\..\Bridges\MAUI\PayabliBinding.csproj')" />
  </ItemGroup>

</Project>
