// Consume the SDK the way a real integrator does: prebuilt XCFrameworks rather
// than package sources.
//
// NOT WIRED YET, and it fails closed rather than silently falling back. A build
// configuration cannot drop a Swift package product: packageProductDependencies
// hangs off the PBXNativeTarget, not off a configuration, so this configuration
// would still link PayabliSDKExampleAggregate from source *in addition to* any
// framework it found. Making it real needs a second target whose
// packageProductDependencies is empty — see the release-pipeline follow-up.

#include "Shared.xcconfig"

PAYABLI_SDK_LINKAGE = xcframework
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG PAYABLI_LINKAGE_XCFRAMEWORK
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../../build/xcframeworks
