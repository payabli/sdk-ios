import Foundation
import PayabliSDKCore

/// Copy this file to `Secrets.swift` and fill in values from your partner
/// backend. `Secrets.swift` is gitignored.
///
/// ## Important: do NOT embed clientSecret here
///
/// The partner's `clientSecret` must never ship in a mobile app binary —
/// anyone who downloads the app can decompile it. Instead, run a backend
/// endpoint (your own API) that performs the token exchange server-side
/// and returns a short-lived `access_token` to the app.
///
/// `PayabliTTP` calls `Secrets.fetchAccessToken()` whenever the SDK needs
/// to refresh the token (the `tokenProvider` closure passed at init).
/// `PayabliPayInPaymentFlow` calls `Secrets.fetchPaymentMethodAccessToken()` right before
/// submitting card or ACH values to `/api/TokenStorage/add`.
/// `PayabliPayInPaymentFlow` calls `Secrets.fetchPaymentCaptureAccessToken()` right before
/// submitting v2 MoneyIn auth/capture requests. The sample aliases this to the
/// same backend endpoint used by PayIn unless your backend separates scopes.
enum Secrets {
    /// Partner integration identifiers (platform `entryName`), one per
    /// environment, because a paypoint exists in exactly one of them.
    ///
    /// Pick the environment with the scheme — `PayabliDemo qa`,
    /// `PayabliDemo sandbox`, `PayabliDemo production` — and the entry point
    /// follows from this map, so the two cannot be left disagreeing. One row is
    /// enough to start; a scheme whose environment has no row is reported on the
    /// Config tab rather than failing later as a bad credential.
    static let entryPoints: [PayabliEnvironment: String] = [
        .sandbox: "<PAYABLI_ENTRY_POINT>"
    ]

    /// The host app's bundle identifier prefixed with the Apple Developer
    /// Team ID (e.g. `"ABCDE12345.com.your.app"`). PayabliTTP forwards this
    /// to App Attest during device attestation.
    ///
    /// For this demo target the bundle identifier is
    /// `com.payabli.example.app`, so the value is
    /// `<TEAM_ID>.com.payabli.example.app`. The TapToPay tab checks
    /// the suffix against `Bundle.main.bundleIdentifier` and warns on screen,
    /// because App Attest otherwise rejects it well into `initialize()`.
    static let appId = "<TEAM_ID>.<BUNDLE_ID>"

    /// Used as the very first token at app launch — the SDK will replace it
    /// via `tokenProvider` on the first 401. In a real integration you'd
    /// fetch the initial token synchronously at launch (see the inline
    /// comment in `PayabliDemoApp.swift`) — this placeholder lets the
    /// `@StateObject` initialiser run without a synchronous network call.
    static let placeholderAccessToken = "placeholder-token"

    /// The Mac running the bundled `LocalTokenServer`, as seen from a physical
    /// device. Only used by the local-QA endpoints below.
    ///
    /// A Bonjour `.local` name rather than an IP, so a DHCP lease change does
    /// not silently break device testing. Get it with `scutil --get LocalHostName`.
    static let localNetworkHost = "<YOUR_MAC_HOSTNAME>.local"

    /// Endpoint on YOUR backend that returns a freshly-minted access token.
    /// Replace with your own URL.
    ///
    /// For local QA against the bundled `LocalTokenServer`, switch this and
    /// `partnerPaymentMethodAccessTokenEndpoint` to the resolver:
    ///
    /// ```swift
    /// static var partnerTokenEndpoint: URL { DemoConfiguration.TokenServer.accessTokenURL }
    /// ```
    ///
    /// which resolves per run — loopback in the Simulator, `localNetworkHost` on
    /// a device — and is overridable at launch with `-PayabliTokenHost <host>`.
    static let partnerTokenEndpoint = URL(string: "https://your-backend.example.com/payabli/token")!

    /// Endpoint on YOUR backend that returns a short-lived Payabli access
    /// token for PayIn payment flow submissions. Do not embed a private
    /// Payabli API key directly in an iOS app.
    static let partnerPaymentMethodAccessTokenEndpoint = URL(
        string: "https://your-backend.example.com/payabli/access-token")!

    /// Enables redacted PayIn request/response logging in the sample app.
    /// Keep this off outside local development.
    static let paymentMethodDiagnosticsEnabled = false

    /// Payment capture QA uses the same diagnostics setting as PayIn payment
    /// flow QA by default.
    static let paymentCaptureDiagnosticsEnabled = paymentMethodDiagnosticsEnabled

    /// Fetches a fresh Payabli access token from the partner backend.
    ///
    /// Your backend should:
    /// 1. Authenticate the mobile user with your own session mechanism.
    /// 2. Call `POST https://api-sandbox.payabli.com/api/v2/token/serverside`
    ///    with your `clientId` + `clientSecret`.
    /// 3. Return the `access_token` from that response.
    static func fetchAccessToken() async throws -> String {
        try await token(from: partnerTokenEndpoint)
    }

    /// Decodes `{ "accessToken": ... }` or `{ "access_token": ... }`.
    private static func token(from url: URL) async throws -> String {
        let (data, _) = try await URLSession.shared.data(from: url)
        struct TokenResponse: Decodable {
            let accessToken: String?
            let access_token: String?
        }
        let response = try JSONDecoder().decode(TokenResponse.self, from: data)
        guard let token = response.accessToken ?? response.access_token else {
            throw URLError(.userAuthenticationRequired)
        }
        return token
    }

    /// Fetches a short-lived PayIn access token from its own endpoint.
    ///
    /// Separate from `fetchAccessToken()` on purpose: the two endpoints are
    /// distinct settings that merely share a value in this sample, and a build
    /// that points them at different backends must honour both.
    static func fetchPaymentMethodAccessToken() async throws -> String {
        try await token(from: partnerPaymentMethodAccessTokenEndpoint)
    }

    /// Fetches a short-lived PayIn capture access token. The sample uses the
    /// same endpoint as the stored-method flow because PayIn submissions use
    /// `Authorization: Bearer <token>`.
    static func fetchPaymentCaptureAccessToken() async throws -> String {
        try await fetchPaymentMethodAccessToken()
    }
}
