import Foundation

/// Copy this file to `Secrets.swift` and fill in values from your partner backend.
/// `Secrets.swift` is gitignored.
///
/// ## Important: do NOT embed clientSecret here
///
/// The partner's `clientSecret` must never ship in a mobile app binary — anyone
/// who downloads the app can decompile it. Instead, run a backend endpoint
/// (your own API) that performs the token exchange server-side and returns a
/// short-lived `access_token` to the app.
///
/// The demo app calls `Secrets.fetchAccessToken()` on launch to obtain a token
/// from your backend. Wire that function to your own endpoint.
enum Secrets {
    /// Payabli customer ID the payment methods belong to.
    static let customerId = 4440

    /// Partner integration identifier (platform `entryName`).
    static let entryPoint = "<YOUR_ENTRY_POINT>"

    /// Optional: stored-method UUID for the stored-method demo screen.
    static let storedMethodId = "<OPTIONAL_STORED_METHOD_UUID>"

    /// Endpoint on YOUR backend that returns a freshly-minted access token.
    /// Replace with your own URL.
    static let partnerTokenEndpoint = URL(string: "https://your-backend.example.com/payabli/token")!

    /// Fetches a fresh Payabli access token from the partner backend.
    ///
    /// Your backend should:
    /// 1. Authenticate the mobile user with your own session mechanism.
    /// 2. Call `POST https://api-sandbox.payabli.com/api/v2/token/serverside`
    ///    with your `clientId` + `clientSecret`.
    /// 3. Return the `access_token` from that response.
    static func fetchAccessToken() async throws -> String {
        let (data, _) = try await URLSession.shared.data(from: partnerTokenEndpoint)
        struct TokenResponse: Decodable { let access_token: String }
        return try JSONDecoder().decode(TokenResponse.self, from: data).access_token
    }
}
