# Selecting a second environment
#
# This file is loaded by name. PAYABLI_ENV_FILE picks a different one, so sandbox is a second file
# rather than an edit to this one, and both can sit side by side:
#
#   cp .env.example .env.sandbox     # then set the sandbox base URL and its own client id/secret
#   PAYABLI_ENV_FILE=.env.sandbox node server.mjs
#
# .gitignore already covers .env.* so a second file stays untracked. A PAYABLI_ENV_FILE naming a file
# that does not exist is fatal rather than a silent fall back to the defaults below.
#
# An entry point exists in one environment, so PAYABLI_API_BASE_URL, the credential and the app's
# -PayabliEnvironment launch argument all move together.

PORT=8787
PAYABLI_LOCAL_TOKEN_SERVER_HOST=127.0.0.1

# Fastest path: paste a short-lived sandbox access token that can call
# /api/TokenStorage/add and the MoneyIn auth/capture endpoints. This is
# returned to the iOS sample as accessToken and used as Authorization: Bearer <token>.
PAYABLI_ACCESS_TOKEN=

# Optional credential-exchange path. If PAYABLI_ACCESS_TOKEN is blank, the
# server posts these values to PAYABLI_TOKEN_PATH and returns the access token.
PAYABLI_CLIENT_ID=
PAYABLI_CLIENT_SECRET=

# Must match DemoConfiguration.environment in the app, which ships as .sandbox.
# To use another environment, change this and pass -PayabliEnvironment to the app.
PAYABLI_API_BASE_URL=https://api-sandbox.payabli.com/api
PAYABLI_TOKEN_PATH=/v2/token/serverside

# Entrypoint used by the Tap to Pay device endpoints (/payabli/devices and
# /payabli/activation-code). Can also be passed per request.
PAYABLI_ENTRY=

# Token exchange is restricted to Payabli hosts by default. Add hosts only
# for trusted local test infrastructure.
PAYABLI_ALLOWED_API_HOSTS=api-sandbox.payabli.com,api-qa.payabli.com,api.payabli.com
PAYABLI_ALLOW_INSECURE_UPSTREAM=false

# Browser CORS is restricted to localhost by default. The native iOS sample
# does not need CORS, but a local web tool can opt in exact origins here.
PAYABLI_ALLOWED_CORS_ORIGINS=
PAYABLI_MAX_REQUEST_BODY_BYTES=32768

# Optional dot path for the token in the exchange response. Leave blank for
# Payabli's standard { "access_token": "..." } response.
PAYABLI_RESPONSE_TOKEN_FIELD=

# Cache exchanged tokens for this many seconds. Set to 0 to disable.
PAYABLI_TOKEN_CACHE_TTL_SECONDS=300
